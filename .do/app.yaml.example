alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED
features:
  - buildpack-stack=ubuntu-22
  - new-nodejs-buildpack=true
name: a11y-before-handoff
region: sgp
services:
  - name: web
    environment_slug: node-js
    github:
      repo: YOUR_GITHUB_NAME/a11y-before-handoff
      branch: main
      deploy_on_push: true
    source_dir: /
    build_command: npm run deploy:build
    run_command: npm start
    http_port: 8080
    instance_count: 1
    instance_size_slug: apps-s-1vcpu-0.5gb
    health_check:
      http_path: /api/health
      initial_delay_seconds: 10
      period_seconds: 15
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 3
    envs:
      - key: NODE_ENV
        value: production
        scope: RUN_TIME
        type: general
